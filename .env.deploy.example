# 生产 .env（复制为 .env 后填写；chmod 600；禁止提交 Git）
SECRET_KEY=please-change-me-long-random
POSTGRES_USER=vflo
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vflo_office

# 数据盘路径（加盘后务必改到 /data）
PG_DATA=/data/pg
BACKUP_DIR=/data/backups
APP_LOGS=/data/logs
APP_UPLOADS=/data/uploads
BACKUP_KEEP_DAYS=30
UVICORN_WORKERS=4

# 应用连接池（单机 32C/256GB 建议）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# 大模型
MIMO_API_KEY=
MIMO_BASE_URL=https://api.mimo.com/v1
MIMO_MODEL=mimo-v2.6
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-128k

# 简道云
JDY_APP_ID=
JDY_API_KEY=
JDY_ENTRY_TASK=
JDY_ENTRY_KNOWLEDGE=
# 简道云 → 本地镜像单向拉取（jdy-poller 服务；默认每小时）
JDY_AUTO_SYNC_ENABLED=1
JDY_SYNC_INTERVAL_SECONDS=3600
JDY_SYNC_MAX_PAGES=200

# 生产关闭开发登录
ENABLE_DEV_LOGIN=0
# 企微扫码登录：凭证填齐即启用；回调地址用内网入口（nginx 8008）
WECOM_LOGIN_ENABLED=1
WECOM_REDIRECT_URI=http://192.168.2.22:8008/api/v1/auth/wecom/callback
# 登录令牌有效期（小时）与开发登录管理员白名单（仅 ENABLE_DEV_LOGIN=1 时生效）
TOKEN_TTL_HOURS=168
DEV_ADMIN_USERS=
# LLM mock 开关：1/true/yes/on 强制 mock；auto=未配置任何模型 Key 时自动 mock
MOCK_LLM=auto
# ===== v1.2 智能对话模块（类 DeepSeek Harness）=====
# 容器内上传目录（compose 已挂载 ${APP_UPLOADS}:/app/uploads，无需改）
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_MB=10
CHAT_MAX_ATTACHMENTS=5
CHAT_HISTORY_TURNS=12
CHAT_FILE_MAX_CHARS=8000
CHAT_FILES_MAX_CHARS=24000
