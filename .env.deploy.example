# 生产 .env（复制为 .env 后填写；chmod 600；禁止提交 Git）
SECRET_KEY=please-change-me-long-random
POSTGRES_USER=vflo
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vflo_office

# 数据盘路径（加盘后务必改到 /data）
PG_DATA=/data/pg
BACKUP_DIR=/data/backups
APP_LOGS=/data/logs
APP_UPLOADS=/data/uploads
BACKUP_KEEP_DAYS=30
UVICORN_WORKERS=4

# 应用连接池（单机 32C/256GB 建议）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# 大模型
MIMO_API_KEY=
MIMO_BASE_URL=https://api.mimo.com/v1
MIMO_MODEL=mimo-v2.6
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-128k

# 简道云
JDY_APP_ID=
JDY_API_KEY=
JDY_ENTRY_TASK=
JDY_ENTRY_KNOWLEDGE=

# 生产关闭开发登录
ENABLE_DEV_LOGIN=0
MOCK_LLM=auto
