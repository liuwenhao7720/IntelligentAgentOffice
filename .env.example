# 复制为 .env 并填写。未配置任何 API Key 时自动 MOCK 模式（本地联调）。

SECRET_KEY=please-change-me
DATABASE_URL=sqlite:///./vflo_office.db
# 生产：DATABASE_URL=postgresql+psycopg://vflo:vflo@localhost:5432/vflo_office

# Mimo V2.6
MIMO_API_KEY=
MIMO_BASE_URL=https://api.mimo.com/v1
MIMO_MODEL=mimo-v2.6

# DeepSeek Harness
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Kimi 3
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-128k

# 企业微信（生产启用，开发可保持默认）
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
ENABLE_DEV_LOGIN=1

MOCK_LLM=auto
REQUEST_TIMEOUT=120
