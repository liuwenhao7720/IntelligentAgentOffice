# 复制为 .env 并填写。未配置任何 API Key 时自动 MOCK 模式（本地联调）。

SECRET_KEY=please-change-me
DATABASE_URL=sqlite:///./vflo_office.db
# 生产：DATABASE_URL=postgresql+psycopg://vflo:vflo@localhost:5432/vflo_office

# Mimo V2.6（sk- 按量密钥用 api.xiaomimimo.com；tp- 套餐密钥用 token-plan-cn.xiaomimimo.com）
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6

# DeepSeek Harness
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Kimi 3（sk-kimi- 密钥用 https://api.kimi.com/coding/v1；k3 需设 KIMI_TEMPERATURE=1）
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-128k
# KIMI_TEMPERATURE=1

# MiniMax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# 企业微信（生产启用，开发可保持默认）
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# 企微扫码登录（qrConnect）：1=凭证齐备即启用；0=关闭（前端自动隐藏扫码入口）
WECOM_LOGIN_ENABLED=1
# 扫码回调地址（企微管理后台「可信域名/回调」需登记；开发默认本机）
WECOM_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/wecom/callback
ENABLE_DEV_LOGIN=1

# 简道云（JianDaoYun）开放接口：配置后自动脱离 MOCK
JDY_APP_ID=
JDY_API_KEY=
JDY_BASE_URL=https://api.jiandaoyun.com/api/v1
JDY_ENTRY_TASK=        # 任务管理表单 entry_id
JDY_ENTRY_KNOWLEDGE=   # 知识库表单 entry_id
# 简道云 → 本地镜像单向拉取（独立 poller 进程；默认每小时，单表单上限 50×100 行）
JDY_AUTO_SYNC_ENABLED=1
JDY_SYNC_INTERVAL_SECONDS=3600
JDY_SYNC_MAX_PAGES=200
# 登录令牌有效期（小时），默认 168=7 天；令牌为 HMAC 无状态签名，重启/多 worker 不失效
TOKEN_TTL_HOURS=168
# 开发登录管理员白名单（逗号分隔：姓名 或 dev_姓名_部门）；不在名单内一律 staff
DEV_ADMIN_USERS=

# LLM mock 开关：1/true/yes/on 强制 mock；auto=未配置任何模型 Key 时自动 mock
MOCK_LLM=auto
REQUEST_TIMEOUT=120
# ===== v1.1 新增 =====
# 制裁名单 API（T19，可插拔；留空=本地参考名单）
SANCTIONS_API_URL=
SANCTIONS_API_KEY=
# CORS 白名单（逗号分隔；留空=仅同源）
CORS_ORIGINS=
# 个人月度 token 额度（0=不限；超额仅提醒）
MONTHLY_TOKEN_QUOTA=0
# ===== v1.2 智能对话模块（类 DeepSeek Harness）=====
# 上传文件存储目录（开发默认 ./data/uploads；生产 compose 注入 /app/uploads）
UPLOAD_DIR=./data/uploads
# 单文件大小上限（MB）
UPLOAD_MAX_MB=10
# 单消息最多携带附件数 / 对话历史轮数
CHAT_MAX_ATTACHMENTS=5
CHAT_HISTORY_TURNS=12
# 附件文本注入上限（字符）：单文件 / 单消息合计
CHAT_FILE_MAX_CHARS=8000
CHAT_FILES_MAX_CHARS=24000
